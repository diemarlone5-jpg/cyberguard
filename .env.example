# --- Réglages de CyberGuard -------------------------------------------------
# Copiez ce fichier en « .env » et remplissez les valeurs.
# Le fichier « .env » ne doit JAMAIS être envoyé sur GitHub.

# production | development
ENVIRONMENT=development

# Origines autorisées à appeler l'API depuis un autre site (séparées par des
# virgules). Vide = aucune autorisation : c'est le réglage le plus sûr, et le
# site fonctionne quand même puisqu'il appelle sa propre API.
ALLOWED_ORIGINS=

# Jeton du bot Telegram — à créer avec @BotFather. Jamais dans le code.
TELEGRAM_BOT_TOKEN=

# Secret du webhook Telegram (laissez vide : le script bot.webhook en génère un).
TELEGRAM_WEBHOOK_SECRET=

# Adresse de l'API vue par le bot en mode « polling » (usage local uniquement).
# Sur Vercel le bot fonctionne en webhook : cette variable n'est pas nécessaire.
CYBERGUARD_API_URL=

# Clé Have I Been Pwned — facultative. Sans elle, le contrôle des fuites
# d'adresses répond « non configuré » au lieu d'inventer une réponse.
HIBP_API_KEY=

# Protection contre l'abus
RATE_LIMIT_PER_MINUTE=40
MAX_BODY_BYTES=16384
